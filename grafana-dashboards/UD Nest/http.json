{
  "uid": "ufal-ud-nest-http",
  "title": "UD Nest - Tráfego HTTP",
  "tags": [
    "ud-nest",
    "http"
  ],
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requisições por segundo",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"ud_nest_api\"}[$__rate_interval]))",
          "legendFormat": "Total",
          "range": true,
          "instant": false
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Requisições por método",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(http_request_duration_seconds_count{job=\"ud_nest_api\"}[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Respostas por código HTTP",
      "description": "Taxa de respostas registradas por código HTTP, incluindo códigos de sucesso.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(http_request_duration_seconds_count{job=\"ud_nest_api\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status_code}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Respostas 4xx e 5xx por segundo",
      "description": "Uma classe sem respostas aparece como zero quando há séries de respostas na janela.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"ud_nest_api\",status_code=~\"4[0-9]{2}\"}[$__rate_interval])) or (0 * sum(rate(http_request_duration_seconds_count{job=\"ud_nest_api\"}[$__rate_interval])))",
          "legendFormat": "4xx",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"ud_nest_api\",status_code=~\"5[0-9]{2}\"}[$__rate_interval])) or (0 * sum(rate(http_request_duration_seconds_count{job=\"ud_nest_api\"}[$__rate_interval])))",
          "legendFormat": "5xx",
          "range": true,
          "instant": false
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Latência HTTP",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"ud_nest_api\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"ud_nest_api\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"ud_nest_api\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "description": "Percentis estimados sobre as respostas concluídas."
    },
    {
      "type": "timeseries",
      "title": "Proporção de respostas 5xx",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_request_duration_seconds_count{job=\"ud_nest_api\",status_code=~\"5[0-9]{2}\"}[$__rate_interval])) or (0 * sum(rate(http_request_duration_seconds_count{job=\"ud_nest_api\"}[$__rate_interval])))) / (sum(rate(http_request_duration_seconds_count{job=\"ud_nest_api\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx",
          "range": true,
          "instant": false
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "description": "Respostas 5xx divididas pelo total de respostas. O painel fica sem valor quando não há respostas na janela."
    },
    {
      "type": "timeseries",
      "title": "Latência p95 por rota",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(http_request_duration_seconds_bucket{job=\"ud_nest_api\",route!=\"unmatched\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}",
          "range": true,
          "instant": false
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "description": "Percentil estimado por método e padrão de rota para respostas com rota identificada."
    }
  ]
}
