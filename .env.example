# Defina uma senha forte e exclusiva antes de iniciar a stack.
# Senha do usuário elastic. Também usada por APM Server e Metricbeat.
ELASTIC_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=

# Senha do usuário interno kibana_system. Sem valor, usa ELASTIC_PASSWORD.
KIBANA_SYSTEM_PASSWORD=

# Opcional no compose.local.yaml. Diretório local que contém ud-nest.yml.
PROMETHEUS_LOCAL_TARGETS_DIR=

# Opcional no compose.local.yaml. Endereço host:porta da UD Nest para o Metricbeat.
METRICBEAT_LOCAL_UD_NEST_HOST=

# Opcional. Porta do proxy reverso nginx no host (padrão 80).
NGINX_HTTP_PORT=

# Opcional. URL pública do proxy, sem barra final e sem caminho (padrão http://localhost).
# Inclua a porta se não for a 80, ex.: http://localhost:8080.
NGINX_PUBLIC_URL=

# Opcional para importar painéis. Sem valores, usa elastic e ELASTIC_PASSWORD.
KIBANA_IMPORT_USERNAME=
KIBANA_IMPORT_PASSWORD=
